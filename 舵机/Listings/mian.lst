  88          void servo_set_angle(float angle){
  89   1          u16 duty;
  90   1          u16 dutyA_val;
  91   1      
  92   1          duty = 500 + (angle * 2000 / 180.0f);
  93   1          dutyB.PWM7_Duty = PERIOD * duty / 20000;
  94   1          UpdatePwm(PWM7, &dutyB);

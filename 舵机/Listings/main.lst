 119          /* ================= 舵机角度输出 ================= */
 120          void servo_update(void)
 121          {
 122   1          u16 dutyB_val;
 123   1          u16 dutyA_val;
 124   1      
 125   1          // P0.2 舵机：0~180° -> 0.5~2.5ms
 126   1          dutyB_val = 500 + (angleB * 2000 / 180.0f);
 127   1          dutyB.PWM7_Duty = PERIOD * dutyB_val / 20000;
 128   1          UpdatePwm(PWM7, &dutyB);
 129   1      
 130   1          // P2.6 舵机：0~90° -> 0.5~1.5ms
 131   1          dutyA_val = 500 + (angleA * 1000 / 90.0f);
 132   1          dutyA.PWM4_Duty = PERIOD * dutyA_val / 20000;
 133   1          UpdatePwm(PWM4, &dutyA);
 134   1      }

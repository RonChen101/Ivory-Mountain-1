  72          /* ================= PWM 初始化 ================= */
  73          void PWM_config(void)
  74          {
  75   1          PWMx_InitDefine PWMx_InitStructure;
  76   1      
  77   1          // 先配置 PWMB 通用寄存器
  78   1          PWMx_InitStructure.PWM_Period        = PERIOD - 1;

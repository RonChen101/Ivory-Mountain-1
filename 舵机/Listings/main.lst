  92   1          PWMx_InitStructure.PWM_DeadTime      = 0;
  93   1          PWMx_InitStructure.PWM_MainOutEnable = ENABLE;
  94   1          PWMx_InitStructure.PWM_CEN_Enable    = ENABLE;
  95   1          PWM_Configuration(PWMA, &PWMx_InitStructure);
  96   1      
  97   1          // 再配置 PWM4 通道
  98   1          PWMx_InitStructure.PWM_Mode      = CCMRn_PWM_MODE1;
  99   1          PWMx_InitStructure.PWM_Duty      = dutyA.PWM4_Duty;

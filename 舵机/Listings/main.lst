  35          /* ================= GPIO 配置 ================= */
  36          void GPIO_config(void)
  37          {
  38   1          GPIO_InitTypeDef info;
  39   1      
  40   1          // UART1  P3.0  P3.1  准双向
  41   1          info.Mode = GPIO_PullUp;
  42   1          info.Pin  = GPIO_Pin_0 | GPIO_Pin_1;
  43   1          GPIO_Inilize(GPIO_P3, &info);
  44   1      
  45   1          // 按键 P5.1 ~ P5.4 准双向
  46   1          P5_MODE_IO_PU(GPIO_Pin_1 | GPIO_Pin_2 | GPIO_Pin_3 | GPIO_Pin_4);
  47   1      
  48   1          // P0.2 推挽输出（PWM7）
  49   1          P0M1 &= ~0x04;
  50   1          P0M0 |=  0x04;
  51   1      
  52   1          // P2.6 推挽输出（PWM4）
  53   1          P2M1 &= ~0x40;
  54   1          P2M0 |=  0x40;

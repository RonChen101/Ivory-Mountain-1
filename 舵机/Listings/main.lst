 136          /* ================= 主函数 ================= */
 137          int main(void)
 138          {
 139   1          EAXSFR();
 140   1          GPIO_config();
 141   1          UART_config();
 142   1      
 143   1          dutyB.PWM7_Duty = PERIOD * 1.5f / 20;
 144   1          dutyA.PWM4_Duty = PERIOD * 1.0f / 20;
 145   1      
 146   1          PWM_config();
 147   1          servo_update();     // 上电先输出初始角度
 148   1      
 149   1          EA = 1;
 150   1      
 151   1          while(1)
 152   1          {
 153   2              /* ---------- KEY1：P0.2 舵机左转 ---------- */
 154   2              if(KEY1 == DOWN)
 155   2              {
 156   3                  angleB -= 1;                     // 左转，角度减小
 157   3                  if(angleB < 0) angleB = 0;
 158   3                  servo_update();
 159   3              }
 160   2      
 161   2              /* ---------- KEY2：P0.2 舵机右转 ---------- */
 162   2              if(KEY2 == DOWN)
 163   2              {
 164   3                  angleB += 1;                     // 右转，角度增大
 165   3                  if(angleB > 180) angleB = 180;
 166   3                  servo_update();
 167   3              }
 168   2      
 169   2              /* ---------- KEY3：P2.6 舵机左转 ---------- */
 170   2              if(KEY3 == DOWN)
 171   2              {
 172   3                  angleA -= 0.5;                   // 左转
 173   3                  if(angleA < 0) angleA = 0;
 174   3                  servo_update();
 175   3              }
 176   2      
 177   2              /* ---------- KEY4：P2.6 舵机右转 ---------- */
 178   2              if(KEY4 == DOWN)
C51 COMPILER V9.60.7.0   MAIN                                                              09/22/2026 15:50:43 PAGE 4   

 179   2              {
 180   3                  angleA += 0.5;                   // 右转
 181   3                  if(angleA > 90) angleA = 90;
 182   3                  servo_update();
 183   3              }
 184   2      
 185   2              delay_ms(10);    // 控制转动速度，数值越小转得越快
 186   2          }
 187   1      }



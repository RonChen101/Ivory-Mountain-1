  53          // 串口1接收逻辑处理
  54          void deal_uart1_recv() {
  55   1              u8 *buf = RX1_Buffer; // 原来的数组名太长了，换个名保存一下
  56   1              char i;
  57   1              
  58   1              // 帧头(2) | 命令(1) | 数据长度(1) | 数据(n) | 校验位(1) | 帧尾(1)
  59   1              //          0  1 2  3  4   5 6
  60   1              // 串口收到 AA AA 00 01 01 00 BB，LED灯组亮灭1次
  61   1              // 串口收到 AA AA 00 01 02 03 BB,   数码管走马灯 1~8
  62   1              // 串口收到 AA AA 00 01 03 02 BB，马达震动一会后停止
  63   1              
  64   1              // 帧头不对，就不要往下执行
  65   1              if (buf[0] != 0xAA || buf[1] != 0xAA) return;
  66   1              // 命令不对，就不要往下执行
  67   1              if (buf[2] != 0x00) return;
  68   1              // 数据长度不对，就不要往下执行
  69   1              if (buf[3] != 0x01) return;
  70   1              // 帧尾不对, 就不要往下执行
  71   1              if (buf[6] != 0xBB) return;
  72   1              
  73   1              // 数据 和 校验值  来确定操作啥
  74   1              if (buf[4] == 0x01 && buf[5] == 0x00) { // LED灯组亮灭1次
  75   2                      LED8 = LED7 = LED6 = LED5 = LED4 = LED3 = LED2 = LED1 = 0; // 低电平亮
  76   2                      delay_ms(250);
  77   2      //              delay_ms(250);
  78   2                      LED8 = LED7 = LED6 = LED5 = LED4 = LED3 = LED2 = LED1 = 1; // 高电平灭
  79   2                      delay_ms(250);
  80   2      //              delay_ms(250);
  81   2              
  82   2              } else if (buf[4] == 0x02 && buf[5] == 0x03) { // 数码管走马灯 1~8
  83   2                      for (i = 1; i <= 8; i++) { // i = 1, 2, …… 8
  84   3                              //          内容, 第几个数码
  85   3                              Nixie_display(i, i);
  86   3                              delay_ms(250);  
  87   3                      }
  88   2                      Nixie_clear(); // 灯灭
  89   2              
  90   2              } else if (buf[4] == 0x03 && buf[5] == 0x02) { // 马达震动一会后停止
  91   2                      P01 = 1; // 震动
  92   2                      delay_ms(250);
  93   2                      delay_ms(250);
  94   2      //              delay_ms(250);
  95   2      //              delay_ms(250);
  96   2                      P01 = 0; // 停止
  97   2              }
  98   1              
  99   1      }

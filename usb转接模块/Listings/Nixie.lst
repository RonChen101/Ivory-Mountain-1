   3          // 索引对应表格参见：
   4          // https://www.yuque.com/mikejiangsky/ca1cyy/sk0cxccrvps7gnuv#ZxeBQ
   5          // 内容0~9，刚好下标也是0~9
   6          u8 code LED_TABLE[] = 
   7          {
   8                  // 0    1        2      -> 9    (索引012...9)
   9                  0xC0,0xF9,0xA4,0xB0,0x99,0x92,0x82,0xF8,0x80,0x90,
  10                  // 0.  1. 2. -> 9.      (索引10,11,12....19)
  11              0x40,0x79,0x24,0x30,0x19,0x12,0x02,0x78,0x00,0x10,
  12                  // . -                                          (索引20,21)

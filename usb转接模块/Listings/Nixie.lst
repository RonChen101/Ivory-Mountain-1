  18          // 初始化
  19          void Nixie_init() {
  20   1              // 推挽  驱动能力强
  21   1              P4_MODE_OUT_PP(GPIO_Pin_2 | GPIO_Pin_3 | GPIO_Pin_4);
  22   1              
  23   1              Nixie_clear(); // 初始化完，所有数码管默认是灭的
  24   1      }
  25          
  26          // num: 控制显示的什么内容
  27          // idx: 控制显示哪几个显示
  28          void Nixie_show(u8 num, u8 idx) {
  29   1              char i;  // 有-操作，不要用u8
  30   1              // 先放内容
  31   1              for (i = 7; i >= 0; i--) {
  32   2                      // 取出第i位，给数据引脚赋值
  33   2                      NIX_DI = num >> i & 1;
  34   2                      
  35   2                      // 移位 0 -> 1
  36   2                      NIX_SCK = 0;
  37   2                      NOP2();
  38   2                      NIX_SCK = 1;
  39   2                      NOP2();
  40   2              }
  41   1              
  42   1              // 再放位置
  43   1              for (i = 7; i >= 0; i--) {
  44   2                      // 取出第i位，给数据引脚赋值
  45   2                      NIX_DI = idx >> i & 1;
  46   2                      
  47   2                      // 移位 0 -> 1
  48   2                      NIX_SCK = 0;
  49   2                      NOP2();
  50   2                      NIX_SCK = 1;
  51   2                      NOP2();
  52   2              }
  53   1              
  54   1              // 锁存
C51 COMPILER V9.60.7.0   NIXIE                                                             05/21/2026 20:20:12 PAGE 2   

  55   1              NIX_RCK = 0;
  56   1              NOP2();
  57   1              NIX_RCK = 1;
  58   1              NOP2();
  59   1      }
  60          
  61          // num 对应的内容在数组的位置(索引)，配合自定义码表
  62          // 码表https://www.yuque.com/mikejiangsky/ca1cyy/sk0cxccrvps7gnuv#ZxeBQ
  63          // 除了0~9，刚好和下标一致，其它的内容，需要查表
  64          // idx  显示在屏幕上的位置(1 -> 8)，只有1个数码管显示
  65          void Nixie_display(u8 num, u8 idx) {
  66   1              Nixie_show(LED_TABLE[num], 1 << (idx - 1));
  67   1      }
  68          
  69          void Nixie_clear() { // 灯灭
  70   1              Nixie_show(0xff, 0x00);
  71   1      }


